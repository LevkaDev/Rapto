# Local release configuration for build.sh and release.sh.
# Copy this file to release.local.env (ignored by git) and fill in your own values.
# You only need it to publish a signed, notarized release; building and running
# Rapto from Xcode does not use it.

# Apple Developer Team ID (10 characters) used to pick the Developer ID certificate.
TEAM_ID=""

# Notarization with an App Store Connect API key...
NOTARY_KEY_ID=""
NOTARY_ISSUER_ID=""
# Defaults to ~/.appstoreconnect/private_keys/AuthKey_<NOTARY_KEY_ID>.p8
NOTARY_KEY_PATH=""
# ...or with a keychain profile created by `xcrun notarytool store-credentials`.
NOTARY_KEYCHAIN_PROFILE=""

# Checkout of the repository that hosts the DMG downloads and appcast.xml,
# and its GitHub name (owner/repo).
RELEASES_REPO=""
GITHUB_REPO=""

# Checkout of the website repository (its changelog is updated on release).
LANDING_REPO=""
